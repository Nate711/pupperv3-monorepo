#!/bin/bash
#
# pupper-pairing — manually toggle comitup WiFi "pairing mode" on Pupper.
#
#   on     Drop the current WiFi so comitup raises the Pupper-Setup-<nnn>
#          hotspot. Saved networks are kept, and NetworkManager will NOT
#          auto-reconnect until 'off' (nmcli device disconnect blocks
#          autoconnect until manual reactivation). comitup holds the hotspot
#          while a phone is connected to it.
#   off    Reconnect wlan0 to the best available saved network.
#   status Print a machine-readable MODE= line for the GUI, plus a human line.
#
# Installed as a local customization for the Pupper GUI "pairing mode" button.
#
set -euo pipefail

DEV=wlan0
cmd="${1:-status}"

active_conn() {
    nmcli -t -f NAME,DEVICE connection show --active \
        | awk -F: -v d="$DEV" '$2==d{print $1; exit}'
}

case "$cmd" in
    on)
        nmcli device disconnect "$DEV"
        echo "pairing-on: $DEV disconnected; comitup will start the setup hotspot"
        ;;
    off)
        # Reconnect; NetworkManager picks the highest-priority saved network
        # that is in range and re-enables autoconnect on the device.
        nmcli device connect "$DEV"
        echo "pairing-off: reconnecting $DEV to best saved network"
        ;;
    status)
        conn="$(active_conn || true)"
        if [ -z "$conn" ]; then
            echo "MODE=disconnected"
            echo "wlan0: not connected"
        else
            mode="$(nmcli -g 802-11-wireless.mode connection show "$conn" 2>/dev/null || true)"
            if [ "$mode" = "ap" ]; then
                echo "MODE=hotspot"
                echo "wlan0: pairing hotspot active ($conn)"
            else
                echo "MODE=connected"
                echo "wlan0: connected to $conn"
            fi
        fi
        ;;
    *)
        echo "usage: pupper-pairing {on|off|status}" >&2
        exit 2
        ;;
esac
